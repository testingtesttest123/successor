+//// Durable host admission requirements survive missing or quarantined owners.
+//// Capability names are generic: only complete active contributors satisfy them.
+
+import albedo/daemon/store
+import gleam/dynamic/decode
+import gleam/list
+import gleam/result
+import sqlight
+
+pub fn initialise(ledger: store.Store) -> Result(Nil, String) {
+  store.query(ledger, initialise_in)
+}
+
+const schema =
+  "CREATE TABLE session_requirements(session TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,capability TEXT NOT NULL,PRIMARY KEY(session,capability))"
+
+/// The core migration marker distinguishes a stock upgrade from lost storage.
+/// Initialization owns this transaction; callers must not nest it in another.
+pub fn initialise_in(db: sqlight.Connection) -> Result(Nil, String) {
+  store.transaction(db, fn() {
+    use _ <- result.try(store.exec(
+      db,
+      "CREATE TABLE IF NOT EXISTS migrations(name TEXT PRIMARY KEY,applied_at INTEGER NOT NULL)",
+    ))
+    use marked <- result.try(store.rows(
+      db,
+      "SELECT name FROM migrations WHERE name='session_requirements_v1'",
+      [],
+      decode.field(0, decode.string, decode.success),
+    ))
+    use existing <- result.try(
+      store.rows(
+        db,
+        "SELECT type,sql FROM sqlite_master WHERE name='session_requirements'",
+        [],
+        {
+          use kind <- decode.field(0, decode.string)
+          use definition <- decode.field(1, decode.string)
+          decode.success(#(kind, definition))
+        },
+      ),
+    )
+    case marked, existing {
+      [], [] -> {
+        use _ <- result.try(store.exec(db, schema))
+        store.exec(
+          db,
+          "INSERT INTO migrations(name,applied_at) VALUES('session_requirements_v1',unixepoch())",
+        )
+      }
+      ["session_requirements_v1"], [#("table", definition)]
+        if definition == schema
+      -> Ok(Nil)
+      _, _ -> Error("session requirements storage is missing or incompatible")
+    }
+  })
+}
+
+/// Call with the same connection and transaction as the owner's binding write.
+pub fn require_in(
+  db: sqlight.Connection,
+  session: String,
+  capability: String,
+) -> Result(Nil, String) {
+  store.run(
+    db,
+    "INSERT OR IGNORE INTO session_requirements(session,capability) VALUES(?,?)",
+    [sqlight.text(session), sqlight.text(capability)],
+  )
+}
+
+/// Only explicit authorized unbinding or native deletion releases requirements.
+pub fn release_in(
+  db: sqlight.Connection,
+  session: String,
+  capability: String,
+) -> Result(Nil, String) {
+  store.run(
+    db,
+    "DELETE FROM session_requirements WHERE session=? AND capability=?",
+    [sqlight.text(session), sqlight.text(capability)],
+  )
+}
+
+/// Missing or unreadable requirement storage is an admission error, never empty.
+pub fn required_in(
+  db: sqlight.Connection,
+  session: String,
+) -> Result(List(String), String) {
+  store.rows(
+    db,
+    "SELECT capability FROM session_requirements WHERE session=? ORDER BY capability",
+    [sqlight.text(session)],
+    decode.field(0, decode.string, decode.success),
+  )
+  |> result.map_error(fn(error) {
+    "session requirements unavailable: " <> error
+  })
+}
+
+pub fn check(
+  ledger: store.Store,
+  session: String,
+  active: List(String),
+) -> Result(Nil, String) {
+  use required <- result.try(store.query(ledger, required_in(_, session)))
+  list.try_each(required, fn(capability) {
+    case list.contains(active, capability) {
+      True -> Ok(Nil)
+      False -> Error("required session capability unavailable: " <> capability)
+    }
+  })
+}
+
+/// Until inheritance is supported, never manufacture an unguarded descendant.
+/// Runs before native writes even when the entire contributing owner is absent.
+pub fn descendant_allowed_in(
+  db: sqlight.Connection,
+  session: String,
+) -> Result(Nil, String) {
+  use required <- result.try(required_in(db, session))
+  case required {
+    [] -> Ok(Nil)
+    _ ->
+      Error(
+        "session requires capabilities; descendant inheritance is unavailable",
+      )
+  }
+}
+
+pub fn descendant_allowed(
+  ledger: store.Store,
+  session: String,
+) -> Result(Nil, String) {
+  store.query(ledger, descendant_allowed_in(_, session))
+}
