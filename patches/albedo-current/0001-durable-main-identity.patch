+pub fn missing_storage_fails_closed_test() -> Nil {
+  let assert Ok(ledger) = store.start(":memory:", "")
+  requirements.check(ledger, "session", []) |> should.be_error
+  store.close(ledger)
+}
+
+pub fn requirements_and_binding_rollback_together_test() -> Nil {
+  let assert Ok(ledger) =
+    store.start(
+      ":memory:",
+      "CREATE TABLE sessions(id TEXT PRIMARY KEY); INSERT INTO sessions VALUES('session'); CREATE TABLE binding(session TEXT);",
+    )
+  let assert Ok(_) = requirements.initialise(ledger)
+  let outcome =
+    store.query(ledger, fn(db) {
+      store.transaction(db, fn() {
+        use _ <- result.try(store.exec(
+          db,
+          "INSERT INTO binding VALUES('session')",
+        ))
+        use _ <- result.try(requirements.require_in(
+          db,
+          "session",
+          "personality",
+        ))
+        Error("rollback")
+      })
+    })
+  outcome |> should.equal(Error("rollback"))
+  store.query(ledger, fn(db) {
+    store.one(
+      db,
+      "SELECT count(*) FROM binding",
+      [],
+      decode.field(0, decode.int, decode.success),
+      "count failed",
+    )
+  })
+  |> should.equal(Ok(0))
+  store.query(ledger, requirements.required_in(_, "session"))
+  |> should.equal(Ok([]))
+  let assert Ok(_) =
+    store.query(ledger, requirements.require_in(_, "session", "personality"))
+  requirements.check(ledger, "session", []) |> should.be_error
+  requirements.check(ledger, "session", ["personality"])
+  |> should.equal(Ok(Nil))
+  store.query(ledger, requirements.descendant_allowed_in(_, "session"))
+  |> should.be_error
+  let assert Ok(_) =
+    store.query(ledger, requirements.release_in(_, "session", "personality"))
+  requirements.check(ledger, "session", []) |> should.equal(Ok(Nil))
+  store.close(ledger)
+}
+
+pub fn required_identity_blocks_native_descendants_without_extension_test() -> Nil {
+  let assert Ok(ledger) = store.start(":memory:", "")
+  let assert Ok(_) = conversation.initialise(ledger)
+  let assert Ok(_) = family.initialise(ledger)
+  let assert Ok(_) = mail.initialise(ledger)
+  let parent =
+    conversation.Info(
+      "parent",
+      "new session",
+      "/tmp",
+      "fixture",
+      "model",
+      types.Responses,
+      conversation.Idle,
+      None,
+      None,
+    )
+  let assert Ok(_) = conversation.create(ledger, parent, [])
+  let assert Ok(_) =
+    conversation.commit(
+      ledger,
+      "parent",
+      [types.User("start")],
+      conversation.Idle,
+    )
+  let assert Ok([first]) = conversation.load_sources(ledger, "parent")
+  let assert Ok(_) =
+    store.query(ledger, requirements.require_in(_, "parent", "personality"))
+  conversation.create_child(
+    ledger,
+    conversation.Info(..parent, id: "child"),
+    "parent",
+    "child",
+    None,
+    [],
+  )
+  |> should.equal(Error(
+    "session requires capabilities; descendant inheritance is unavailable",
+  ))
+  history.fork(ledger, "parent", "fork", first.source.seq, [])
+  |> should.equal(Error(
+    "session requires capabilities; descendant inheritance is unavailable",
+  ))
+  history.rewind(ledger, "parent", "archive", first.source.seq, None, None, [])
+  |> should.equal(Error(
+    "session requires capabilities; descendant inheritance is unavailable",
+  ))
+  store.query(ledger, conversation.read_info(_, "child")) |> should.be_error
+  store.query(ledger, conversation.read_info(_, "fork")) |> should.be_error
+  store.query(ledger, conversation.read_info(_, "archive")) |> should.be_error
+  store.close(ledger)
+}
