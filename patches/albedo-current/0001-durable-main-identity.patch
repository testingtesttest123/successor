+fn fixture(host: runtime.Runtime) -> session_state.State(Nil) {
+  session_state.State(
+    active_output: active_output.new("/tmp", "idle-fixture", "generation"),
+    info: conversation.Info(
+      "idle-fixture",
+      "test",
+      "/tmp",
+      "none",
+      "none",
+      types.Responses,
+      conversation.Idle,
+      None,
+      None,
+    ),
+    host: host,
+    kernel: None,
+    released: None,
+    home: "/tmp",
+    self: process.new_subject(),
+    history: None,
+    latest_usage: None,
+    activity: turn.Resting,
+    steering: [],
+    active_submissions: [],
+    sequence: 0,
+    events: event_buffer.new(),
+    watchers: [],
+    notice: None,
+    context: session_state.unprepared(),
+    pin: loop.Unpinned,
+    prepared_head: None,
+    last_touch: 0,
+    booting: None,
+    blocked_until: 0,
+    generation: "generation",
+    tool_progress: tool_progress.new(),
+    progress_timer_token: 0,
+    progress_timer: None,
+    live_activity: session_activity.new(0),
+    announced_status: None,
+    pending_output: [],
+    output_timer: None,
+    output_published_at: 0,
+    publish_output: Nil,
+  )
+}
+
+pub fn idle_callback_gets_native_store_and_session_and_propagates_error_test() -> Nil {
+  let assert Ok(host) =
+    runtime.start_with_config(":memory:", extensions.Config([], []))
+  let state = fixture(host)
+  let applied =
+    session_configure.apply_idle(state, fn(db, id) {
+      use _ <- result.try(
+        store.write(db, "CREATE TABLE idle_bridge_test(value TEXT)", []),
+      )
+      Ok(json.string(id))
+    })
+  let failed =
+    session_configure.apply_idle(state, fn(_, _) {
+      Error("transaction refused")
+    })
+  runtime.stop(host)
+  applied |> result.map(json.to_string) |> should.equal(Ok("\"idle-fixture\""))
+  failed |> should.equal(Error("transaction refused"))
+}
+
+pub fn booting_or_running_refuses_before_callback_test() -> Nil {
+  let assert Ok(host) =
+    runtime.start_with_config(":memory:", extensions.Config([], []))
+  let state = fixture(host)
+  let called = process.new_subject()
+  let run = fn(_, _) {
+    process.send(called, Nil)
+    Ok(json.null())
+  }
+  let booting =
+    session_configure.apply_idle(
+      session_state.State(..state, booting: Some(#(1, []))),
+      run,
+    )
+  let monitor = process.monitor(process.self())
+  let active =
+    turn.Running(turn.Run(
+      "run",
+      process.self(),
+      monitor,
+      False,
+      turn.latch(),
+      turn.Turn(None, False),
+    ))
+  let running =
+    session_configure.apply_idle(
+      session_state.State(..state, activity: active),
+      run,
+    )
+  process.demonitor_process(monitor)
+  runtime.stop(host)
+  booting |> should.equal(Error("session_busy"))
+  running |> should.equal(Error("session_busy"))
+  process.receive(called, 0) |> should.be_error
+}
+
+pub fn callback_crash_is_caught_test() -> String {
+  let assert Ok(host) =
+    runtime.start_with_config(":memory:", extensions.Config([], []))
+  let outcome =
+    session_configure.apply_idle(fixture(host), fn(_, _) {
+      panic as "fixture crash"
+    })
+  runtime.stop(host)
+  outcome |> should.be_error
+}
+
+pub fn input_preparation_cannot_forward_idle_mutation_test() -> Nil {
+  let called = process.new_subject()
+  let context =
+    command.Context(fn(_) {
+      process.send(called, Nil)
+      Ok(json.null())
+    })
+  let operation =
+    command.Command("/fixture", "", [], False, True, False, None, fn(ctx, _, _) {
+      use _ <- result.try(
+        ctx.state(command.ApplyIdle(fn(_, _) { Ok(json.null()) })),
+      )
+      Ok(command.Turn("display", "text"))
+    })
+  command.prepare_input(operation, context, dict.new())
+  |> should.equal(Error("input preparation cannot mutate session state"))
+  process.receive(called, 0) |> should.be_error
+}
