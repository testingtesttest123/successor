diff --git a/src/albedo/harness/request_context.gleam b/src/albedo/harness/request_context.gleam
new file mode 100644
index 0000000000000000000000000000000000000000..02b28ab71bddf5f5d1feae3699fecd670da01344
--- /dev/null
+++ b/src/albedo/harness/request_context.gleam
@@ -0,0 +1,272 @@
+//// Captured native request contributions. Callbacks promise bounded read-only
+//// work; this interface is a semantic contract, not a closure sandbox.
+
+import albedo/daemon/store
+import albedo/harness/protect
+import albedo/openai_api/types
+import albedo/text_scalars
+import gleam/bit_array
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/result
+import gleam/string
+
+pub type Budget {
+  Budget(
+    capacity_tokens: Option(Int),
+    capacity_source: Option(String),
+    static_tokens: Int,
+    remaining_tokens: Option(Int),
+  )
+}
+
+pub type Input {
+  Input(
+    store: store.Store,
+    session: String,
+    loaded: List(String),
+    query: String,
+    budget: Budget,
+  )
+}
+
+pub type Block {
+  Block(name: String, content: String, mandatory: Bool)
+}
+
+pub type Contribution {
+  Contribution(
+    snapshot_id: String,
+    instructions: List(Block),
+    data: List(Block),
+    diagnostics: List(String),
+  )
+}
+
+pub type Captured {
+  Captured(owner: String, value: Contribution)
+}
+
+pub type Kind {
+  Instructions
+  Data
+}
+
+pub type Selected {
+  Selected(owner: String, snapshot_id: String, kind: Kind, block: Block)
+}
+
+pub type Omission {
+  Omission(
+    owner: String,
+    snapshot_id: String,
+    kind: Kind,
+    name: String,
+    reason: String,
+  )
+}
+
+pub type Prepared {
+  Prepared(
+    contributions: List(Captured),
+    blocks: List(Selected),
+    omissions: List(Omission),
+    budget: Budget,
+  )
+}
+
+pub type Failure {
+  Failure(reason: String, captured: Prepared)
+}
+
+pub fn failure(reason: String, captured: Prepared) -> Failure {
+  Failure(text_scalars.take(reason, 2048), captured)
+}
+
+pub type Inspection {
+  Inspection(
+    captured: Prepared,
+    estimated_tokens: Int,
+    fits: Bool,
+    failure: Option(String),
+  )
+}
+
+pub type Final {
+  Final(
+    request: types.Request,
+    captured: Prepared,
+    estimated_tokens: Int,
+    fits: Bool,
+    failure: Option(String),
+  )
+}
+
+pub fn prepare(
+  callbacks: List(#(String, fn(Input) -> Result(Contribution, String))),
+  input: Input,
+) -> Result(Prepared, Failure) {
+  capture(callbacks, input, Prepared([], [], [], input.budget))
+}
+
+fn capture(
+  callbacks: List(#(String, fn(Input) -> Result(Contribution, String))),
+  input: Input,
+  prepared: Prepared,
+) -> Result(Prepared, Failure) {
+  case callbacks {
+    [] -> Ok(prepared)
+    [callback, ..rest] -> {
+      use value <- result.try(
+        protect.guarded(fn() { callback.1(input) })
+        |> result.map_error(fn(error) {
+          failure("request context " <> callback.0 <> ": " <> error, prepared)
+        }),
+      )
+      let selected = fn(kind, block) {
+        Selected(callback.0, value.snapshot_id, kind, block)
+      }
+      let blocks =
+        list.append(
+          list.map(value.instructions, selected(Instructions, _)),
+          list.map(value.data, selected(Data, _)),
+        )
+      capture(
+        rest,
+        input,
+        Prepared(
+          ..prepared,
+          contributions: list.append(prepared.contributions, [
+            Captured(callback.0, value),
+          ]),
+          blocks: list.append(prepared.blocks, blocks),
+        ),
+      )
+    }
+  }
+}
+
+/// Mandatory context reserves compaction space; optional context is admitted
+/// against the final projected history, so it cannot force avoidable eviction.
+pub fn mandatory(prepared: Prepared) -> Prepared {
+  Prepared(
+    ..prepared,
+    blocks: list.filter(prepared.blocks, fn(selected) {
+      selected.block.mandatory
+    }),
+  )
+}
+
+/// Recent user/steering text, never a complete transcript; UTF-8 scalars stay
+/// whole even when one crosses the byte boundary.
+pub fn query(history: List(types.Input)) -> String {
+  let text =
+    history
+    |> list.reverse
+    |> list.find_map(fn(input) {
+      case input {
+        types.User(text) | types.UserImage(text, _) -> Ok(text)
+        _ -> Error(Nil)
+      }
+    })
+    |> result.unwrap("")
+  let size = bounded_size(<<text:utf8>>, 4096, 0)
+  let assert <<prefix:bytes-size(size), _:bytes>> = <<text:utf8>>
+  bit_array.to_string(prefix) |> result.unwrap("")
+}
+
+fn bounded_size(bytes: BitArray, allowance: Int, used: Int) -> Int {
+  case bytes {
+    <<point:utf8_codepoint, rest:bytes>> -> {
+      let size = bit_array.byte_size(<<point:utf8_codepoint>>)
+      case size <= allowance {
+        True -> bounded_size(rest, allowance - size, used + size)
+        False -> used
+      }
+    }
+    _ -> used
+  }
+}
+
+pub fn render(selected: Selected) -> String {
+  "[request context: "
+  <> selected.block.name
+  <> "; snapshot "
+  <> selected.snapshot_id
+  <> "]\n"
+  <> selected.block.content
+}
+
+/// Pure assembly. Dynamic data precedes projected history and never becomes
+/// raw compaction input or a durable transcript row.
+pub fn assemble(base: types.Request, prepared: Prepared) -> types.Request {
+  let suffix =
+    prepared.blocks
+    |> list.filter(fn(block) { block.kind == Instructions })
+    |> list.map(fn(block) { "\n\n" <> render(block) })
+    |> string.concat
+  let data =
+    prepared.blocks
+    |> list.filter(fn(block) { block.kind == Data })
+    |> list.map(fn(block) { types.User(render(block)) })
+  types.Request(
+    ..base,
+    instructions: case suffix {
+      "" -> base.instructions
+      _ -> Some(option.unwrap(base.instructions, "") <> suffix)
+    },
+    input: list.append(data, base.input),
+  )
+}
+
+/// Price the actual assembled request once. Drop the last optional block
+/// whole until it fits. Earlier omissions stay omitted after pin settlement.
+/// `reserve` leaves room for history in the initial static reservation only.
+pub fn reconcile(
+  base: types.Request,
+  prepared: Prepared,
+  estimate: fn(types.Request) -> Int,
+  reserve: Int,
+) -> Final {
+  let request = assemble(base, prepared)
+  let estimated = estimate(request)
+  let fits = case prepared.budget.capacity_tokens {
+    None -> True
+    Some(capacity) -> estimated + reserve <= capacity
+  }
+  case fits {
+    True -> Final(request, prepared, estimated, True, None)
+    False -> {
+      let reversed = list.reverse(prepared.blocks)
+      let #(after, rest) =
+        list.split_while(reversed, fn(selected) { selected.block.mandatory })
+      case rest {
+        [] ->
+          Final(
+            request,
+            prepared,
+            estimated,
+            False,
+            Some("mandatory request content exceeds known context window"),
+          )
+        [omitted, ..before] -> {
+          let selected =
+            Prepared(
+              ..prepared,
+              blocks: list.reverse(list.append(after, before)),
+              omissions: list.append(prepared.omissions, [
+                Omission(
+                  omitted.owner,
+                  omitted.snapshot_id,
+                  omitted.kind,
+                  omitted.block.name,
+                  "whole optional block exceeds known request allowance",
+                ),
+              ]),
+            )
+          reconcile(base, selected, estimate, reserve)
+        }
+      }
+    }
+  }
+}
