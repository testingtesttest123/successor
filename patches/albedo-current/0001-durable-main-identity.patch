+@external(erlang, "albedo_runtime_test_support", "temporary_database")
+fn temporary_database() -> String
+
+@external(erlang, "albedo_runtime_test_support", "cleanup")
+fn cleanup(path: String) -> Nil
+
+pub fn requirements_survive_reopen_and_delete_with_session_test() -> Nil {
+  let path = temporary_database()
+  let assert Ok(ledger) =
+    store.start(
+      path,
+      "CREATE TABLE sessions(id TEXT PRIMARY KEY); INSERT INTO sessions VALUES('session');",
+    )
+  let assert Ok(_) = requirements.initialise(ledger)
+  let assert Ok(_) =
+    store.query(ledger, requirements.require_in(_, "session", "personality"))
+  store.close(ledger)
+  let assert Ok(reopened) = store.start(path, "")
+  let assert Ok(_) = requirements.initialise(reopened)
+  requirements.check(reopened, "session", []) |> should.be_error
+  requirements.check(reopened, "session", ["personality"])
+  |> should.equal(Ok(Nil))
+  let assert Ok(_) =
+    store.query(reopened, fn(db) {
+      store.exec(
+        db,
+        "PRAGMA foreign_keys=ON; DELETE FROM sessions WHERE id='session';",
+      )
+    })
+  store.query(reopened, requirements.required_in(_, "session"))
+  |> should.equal(Ok([]))
+  store.close(reopened)
+  cleanup(path)
+}
+
+pub fn restart_does_not_recreate_lost_requirement_storage_test() -> Nil {
+  let path = temporary_database()
+  let assert Ok(ledger) =
+    store.start(
+      path,
+      "CREATE TABLE sessions(id TEXT PRIMARY KEY); INSERT INTO sessions VALUES('session');",
+    )
+  let assert Ok(_) = requirements.initialise(ledger)
+  let assert Ok(_) =
+    store.query(ledger, requirements.require_in(_, "session", "personality"))
+  let assert Ok(_) =
+    store.query(ledger, fn(db) {
+      store.exec(db, "DROP TABLE session_requirements")
+    })
+  store.close(ledger)
+  let assert Ok(reopened) = store.start(path, "")
+  requirements.initialise(reopened) |> should.be_error
+  requirements.check(reopened, "session", []) |> should.be_error
+  store.close(reopened)
+  cleanup(path)
+}
+
+pub fn incompatible_requirement_storage_refuses_initialisation_test() -> Nil {
+  let assert Ok(ledger) =
+    store.start(
+      ":memory:",
+      "CREATE TABLE sessions(id TEXT PRIMARY KEY); CREATE VIEW session_requirements AS SELECT id AS session, 'personality' AS capability FROM sessions;",
+    )
+  requirements.initialise(ledger) |> should.be_error
+  store.close(ledger)
+}
