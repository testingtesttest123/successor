@@ -0,0 +1,265 @@
+"""The test launch owns orphan reaping; assertions still require actual absence."""
+
+import ctypes
+import os
+from pathlib import Path
+import subprocess
+import signal
+import sys
+import tempfile
+import textwrap
+import time
+import unittest
+
+TEST = Path(__file__).resolve().parents[1]
+OWNER = [sys.executable, str(TEST / "process_owner.py")]
+
+
+@unittest.skipUnless(sys.platform == "linux", "Linux child-subreaper ownership")
+class TestProcessOwner(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        libc = ctypes.CDLL(None, use_errno=True)
+        if libc.prctl(36, 1, 0, 0, 0):
+            error = ctypes.get_errno()
+            raise OSError(error, os.strerror(error))
+
+    def run_command(self, code):
+        process = subprocess.Popen(
+            [*OWNER, sys.executable, "-c", code],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        try:
+            stdout, stderr = process.communicate(timeout=10)
+        finally:
+            if process.poll() is None:
+                process.terminate()
+                process.wait(timeout=6)
+        with self.assertRaises(ChildProcessError):
+            os.waitpid(process.pid, os.WNOHANG)
+        return process.returncode, stdout, stderr
+
+    def reap_fixture(self, report):
+        if not report.exists():
+            return
+        pid = int(report.read_text())
+        try:
+            child, _ = os.waitpid(pid, os.WNOHANG)
+            if child == 0:
+                os.kill(pid, 9)
+                os.waitpid(pid, 0)
+        except ChildProcessError:
+            pass
+
+    def test_preserves_command_exit_status_and_output(self):
+        status, stdout, _ = self.run_command(
+            "print('command output'); raise SystemExit(23)"
+        )
+        self.assertEqual(status, 23)
+        self.assertEqual(stdout, "command output\n")
+
+    def test_keeps_the_commands_direct_child_status(self):
+        status, _, stderr = self.run_command(
+            "import subprocess, sys; child=subprocess.Popen([sys.executable, '-c', 'raise SystemExit(19)']); "
+            "raise SystemExit(0 if child.wait()==19 else 31)"
+        )
+        self.assertEqual(status, 0, stderr)
+
+    def test_reaps_after_the_main_command_is_killed(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            try:
+                status, _, _ = self.run_command(
+                    "import os, signal, subprocess; from pathlib import Path; "
+                    "child=subprocess.Popen(['sleep', '30'], start_new_session=True); "
+                    f"Path({str(report)!r}).write_text(str(child.pid)); "
+                    "os.kill(os.getpid(), signal.SIGKILL)"
+                )
+                self.assertEqual(status, 137)
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(int(report.read_text()), 0)
+            finally:
+                self.reap_fixture(report)
+
+    def test_live_descendant_leak_fails_without_killing_an_unrelated_process(self):
+        outsider = subprocess.Popen(["sleep", "30"])
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            try:
+                status, _, stderr = self.run_command(
+                    "import subprocess; from pathlib import Path; "
+                    "child=subprocess.Popen(['sleep', '30'], start_new_session=True); "
+                    f"Path({str(report)!r}).write_text(str(child.pid))"
+                )
+                self.assertEqual(status, 1, stderr)
+                self.assertIn("live descendants after command exit", stderr)
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(int(report.read_text()), 0)
+                self.assertIsNone(outsider.poll())
+            finally:
+                self.reap_fixture(report)
+                outsider.terminate()
+                outsider.wait(timeout=5)
+
+    def test_live_orphan_is_not_signalled_while_the_command_runs(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            code = textwrap.dedent(f"""
+                import os, signal, time
+                from pathlib import Path
+                parent = os.fork()
+                if parent == 0:
+                    child = os.fork()
+                    if child == 0:
+                        os.execlp('sleep', 'sleep', '30')
+                    Path({str(report)!r}).write_text(str(child))
+                    os._exit(0)
+                os.waitpid(parent, 0)
+                child = int(Path({str(report)!r}).read_text())
+                time.sleep(0.2)
+                os.kill(child, 0)
+                os.kill(child, signal.SIGTERM)
+                for _ in range(50):
+                    try:
+                        os.kill(child, 0)
+                    except ProcessLookupError:
+                        raise SystemExit(0)
+                    time.sleep(0.02)
+                raise SystemExit(32)
+            """)
+            try:
+                status, _, stderr = self.run_command(code)
+                self.assertEqual(status, 0, stderr)
+            finally:
+                self.reap_fixture(report)
+
+    def test_sigterm_is_forwarded_and_the_owner_is_waited(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            code = f"import os,time; from pathlib import Path; Path({str(report)!r}).write_text(str(os.getpid())); time.sleep(30)"
+            process = subprocess.Popen([*OWNER, sys.executable, "-c", code])
+            try:
+                deadline = time.monotonic() + 3
+                while not report.exists():
+                    self.assertLess(time.monotonic(), deadline)
+                    time.sleep(0.01)
+                process.terminate()
+                self.assertEqual(process.wait(timeout=6), 143)
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(int(report.read_text()), 0)
+                with self.assertRaises(ChildProcessError):
+                    os.waitpid(process.pid, os.WNOHANG)
+            finally:
+                if process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=6)
+                self.reap_fixture(report)
+
+    def test_stopped_child_is_not_mistaken_for_an_exited_child(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            code = f"import os,signal; from pathlib import Path; Path({str(report)!r}).write_text(str(os.getpid())); os.kill(os.getpid(),signal.SIGSTOP); raise SystemExit(19)"
+            process = subprocess.Popen([*OWNER, sys.executable, "-c", code])
+            try:
+                deadline = time.monotonic() + 3
+                while not report.exists():
+                    self.assertLess(time.monotonic(), deadline)
+                    time.sleep(0.01)
+                pid = int(report.read_text())
+                while (
+                    Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
+                    != "T"
+                ):
+                    self.assertLess(time.monotonic(), deadline)
+                    time.sleep(0.01)
+                self.assertIsNone(process.poll())
+                os.kill(pid, signal.SIGCONT)
+                self.assertEqual(process.wait(timeout=6), 19)
+            finally:
+                if process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=6)
+                self.reap_fixture(report)
+
+    def nested_leak(self, main_status):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "grandchild.pid"
+            middle = (
+                "import signal,subprocess,time; from pathlib import Path; "
+                "signal.signal(signal.SIGTERM,signal.SIG_IGN); "
+                "child=subprocess.Popen(['sleep','30'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); "
+                f"Path({str(report)!r}).write_text(str(child.pid)); time.sleep(30)"
+            )
+            main = textwrap.dedent(f"""
+                import subprocess,sys,time
+                from pathlib import Path
+                subprocess.Popen([sys.executable,'-c',{middle!r}],start_new_session=True)
+                while not Path({str(report)!r}).exists():
+                    time.sleep(0.01)
+                raise SystemExit({main_status})
+            """)
+            try:
+                status, _, stderr = self.run_command(main)
+                self.assertEqual(status, main_status or 1, stderr)
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(int(report.read_text()), 0)
+            finally:
+                self.reap_fixture(report)
+
+    def test_cleanup_reaps_newly_adopted_term_resistant_descendants(self):
+        self.nested_leak(0)
+
+    def test_nested_cleanup_preserves_an_already_failed_command_status(self):
+        self.nested_leak(23)
+
+    def test_python_runner_reaps_orphans_before_the_test_finishes(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "orphan.pid"
+            fixture = Path(folder) / "fixture_test.py"
+            fixture.write_text(
+                textwrap.dedent(f"""
+                import os, time, unittest
+                from pathlib import Path
+                class Orphan(unittest.TestCase):
+                    def test_physical_absence(self):
+                        parent = os.fork()
+                        if parent == 0:
+                            child = os.fork()
+                            if child == 0:
+                                os._exit(0)
+                            Path({str(report)!r}).write_text(str(child))
+                            os.waitid(os.P_PID, child, os.WEXITED | os.WNOWAIT)
+                            os._exit(0)
+                        os.waitpid(parent, 0)
+                        child = int(Path({str(report)!r}).read_text())
+                        for _ in range(50):
+                            try:
+                                os.kill(child, 0)
+                            except ProcessLookupError:
+                                return
+                            time.sleep(0.02)
+                        self.fail('exited orphan remained in the process table')
+            """)
+            )
+            try:
+                result = subprocess.run(
+                    [sys.executable, str(TEST / "python_test_runner.py"), str(fixture)],
+                    capture_output=True,
+                    text=True,
+                    timeout=10,
+                )
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            finally:
+                # In RED this test owns the retained orphan. Reap it only after
+                # the inner physical-absence assertion has produced its result.
+                if report.exists():
+                    try:
+                        os.waitpid(int(report.read_text()), 0)
+                    except ChildProcessError:
+                        pass
+
+
+if __name__ == "__main__":
+    unittest.main()
