index 0000000..2763e0b
--- /dev/null
+++ b/test/process_owner.py
@@ -0,0 +1,145 @@
+"""Run a test command with explicit orphan ownership on Linux.
+
+    python3 test/process_owner.py <command> [args...]
+
+Only exited adopted children are reaped while the command runs. The command
+keeps its own direct-child statuses. A successful return proves that no child
+remains. This is test infrastructure, not a production kernel supervisor.
+"""
+
+import ctypes
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+DRAIN = 2.0  # post-command cleanup, not a test assertion's timeout
+TERM = 0.25
+KILL = 2.0
+POLL = 0.01
+
+
+def children() -> list[int]:
+    """Only our direct children, including newly adopted orphans."""
+    owned = []
+    for entry in Path("/proc").iterdir():
+        if not entry.name.isdigit():
+            continue
+        try:
+            fields = (entry / "stat").read_text().rsplit(")", 1)[1].split()
+        except FileNotFoundError:
+            continue
+        if int(fields[1]) == os.getpid():
+            owned.append(int(entry.name))
+    return owned
+
+
+def signal_children(sig: int) -> None:
+    # A child's pid cannot be reused until this single-threaded owner reaps it.
+    for pid in children():
+        try:
+            os.kill(pid, sig)
+        except ProcessLookupError:
+            pass
+
+
+def run(command: list[str]) -> int:
+    if sys.platform != "linux":
+        os.execvp(command[0], command)
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.prctl.argtypes = [
+        ctypes.c_int,
+        ctypes.c_ulong,
+        ctypes.c_ulong,
+        ctypes.c_ulong,
+        ctypes.c_ulong,
+    ]
+    libc.prctl.restype = ctypes.c_int
+    if libc.prctl(36, 1, 0, 0, 0):  # PR_SET_CHILD_SUBREAPER; this owner only
+        error = ctypes.get_errno()
+        raise OSError(error, os.strerror(error))
+
+    pending = 0
+
+    def interrupted(sig, _frame):
+        nonlocal pending
+        pending = sig
+
+    previous = {
+        sig: signal.signal(sig, interrupted) for sig in (signal.SIGINT, signal.SIGTERM)
+    }
+    process = None
+    status = None
+    deadline = None
+    stage = 0
+    cancellation = False
+    cleanup_failed = False
+    try:
+        process = subprocess.Popen(command, start_new_session=True)
+        while True:
+            no_children = False
+            while True:
+                try:
+                    pid, raw = os.waitpid(-1, os.WNOHANG)
+                except ChildProcessError:
+                    no_children = True
+                    break
+                if pid == 0:
+                    break
+                if pid == process.pid:
+                    status = os.waitstatus_to_exitcode(raw)
+                    process.returncode = status
+            if status is not None and no_children:
+                return (status if status >= 0 else 128 - status) or int(cleanup_failed)
+            now = time.monotonic()
+            if pending:
+                cancellation = True
+                if status is None:
+                    try:
+                        os.killpg(process.pid, pending)
+                    except ProcessLookupError:
+                        pass
+                pending = 0
+                deadline = now + TERM
+            if status is not None and deadline is None:
+                deadline = now + DRAIN
+            if deadline is not None and now >= deadline:
+                if stage == 0:
+                    if not cancellation:
+                        cleanup_failed = True
+                        print(
+                            "test owner: live descendants after command exit; cleaning owned children",
+                            file=sys.stderr,
+                        )
+                    signal_children(signal.SIGTERM)
+                    deadline = now + TERM
+                    stage = 1
+                elif stage == 1:
+                    if status is None:
+                        try:
+                            os.killpg(process.pid, signal.SIGKILL)
+                        except ProcessLookupError:
+                            pass
+                    signal_children(signal.SIGKILL)
+                    deadline = now + KILL
+                    stage = 2
+                else:
+                    raise RuntimeError(
+                        f"test owner: cleanup unproved; owned children remain: {children()}"
+                    )
+            if stage == 2:
+                # Killing a parent can adopt another level of descendants.
+                # Keep the same absolute KILL deadline while ending those too.
+                signal_children(signal.SIGKILL)
+            time.sleep(POLL)
+    finally:
+        for sig, handler in previous.items():
+            signal.signal(sig, handler)
+
+
+if __name__ == "__main__":
+    if not sys.argv[1:]:
+        raise SystemExit("usage: process_owner.py <command> [args...]")
+    raise SystemExit(run(sys.argv[1:]))
