@@ -0,0 +1,65 @@
+//// Durable lifecycle contributions use the creator's transaction connection.
+//// Guards use bounded read-only SQL. Apply may write only on this connection:
+//// no actor reentry, nested transactions, bus, processes, kernels, providers
+//// or external effects. Declarations are trusted host code.
+
+import albedo/daemon/transcript
+import albedo/harness/protect
+import gleam/list
+import gleam/result
+import sqlight
+
+pub type Event {
+  Created(session: String)
+  Child(parent: String, child: String)
+  /// Actual copied rows in source order; excludes synthetic tool completions.
+  Fork(
+    parent: String,
+    child: String,
+    checkpoint: Int,
+    mapping: List(#(transcript.SourceRef, transcript.SourceRef)),
+  )
+}
+
+pub type Contribution {
+  Contribution(
+    needed_in: fn(sqlight.Connection, Event) -> Result(Bool, String),
+    apply_in: fn(sqlight.Connection, Event) -> Result(Nil, String),
+  )
+}
+
+pub type Availability {
+  Ready
+  Quarantined(reason: String)
+}
+
+pub type Owner {
+  Owner(
+    name: String,
+    availability: Availability,
+    contributions: List(Contribution),
+  )
+}
+
+/// Run inside the native transaction and admission mutation. Catchable crashes
+/// become errors in the same process so the caller rolls back all native writes.
+pub fn run_in(
+  db: sqlight.Connection,
+  owners: List(Owner),
+  event: Event,
+) -> Result(Nil, String) {
+  list.try_each(owners, fn(owner) {
+    list.try_each(owner.contributions, fn(contribution) {
+      protect.guarded(fn() {
+        use needed <- result.try(contribution.needed_in(db, event))
+        case needed, owner.availability {
+          False, _ -> Ok(Nil)
+          True, Ready -> contribution.apply_in(db, event)
+          True, Quarantined(reason) ->
+            Error("required lifecycle owner is quarantined: " <> reason)
+        }
+      })
+      |> result.map_error(fn(reason) { owner.name <> ": " <> reason })
+    })
+  })
+}
