+/// Retain canonical declarations before installation discards failed owners.
+/// A duplicate's quarantine cannot change the first owner's availability.
+pub fn lifecycle_owners(
+  declarations: List(Extension),
+  installed: List(Extension),
+  failures: List(Quarantined),
+) -> List(session_lifecycle.Owner) {
+  let #(canonical, _) = distinctly_named(declarations)
+  list.filter_map(canonical, fn(declaration) {
+    let contributions =
+      plugin_values([declaration], fn(_, plugin) {
+        case plugin {
+          SessionLifecyclePlugin(value) -> Ok(value)
+          _ -> Error(Nil)
+        }
+      })
+    case contributions {
+      [] -> Error(Nil)
+      _ -> {
+        let ready =
+          list.any(installed, fn(ext) { ext.name == declaration.name })
+        let availability = case ready {
+          True -> session_lifecycle.Ready
+          False -> {
+            let reason =
+              list.find(failures, fn(failure) {
+                failure.name == declaration.name
+              })
+              |> result.map(fn(failure) { failure.reason })
+              |> result.unwrap("owner was not installed")
+            session_lifecycle.Quarantined(reason)
+          }
+        }
+        Ok(session_lifecycle.Owner(
+          declaration.name,
+          availability,
+          contributions,
+        ))
+      }
+    }
+  })
+}
+
