+/// Captures belong only to fully active bundles. A required requested bundle
+/// that failed static/managed loading refuses preparation before any callback.
+pub fn request_contributors(
+  composition: Composition,
+) -> Result(
+  List(
+    #(
+      String,
+      fn(request_context.Input) -> Result(request_context.Contribution, String),
+    ),
+  ),
+  String,
+) {
+  let active = list.map(composition.extensions, fn(item) { item.name })
+  use _ <- result.try(
+    list.try_each(composition.requested, fn(item) {
+      let required =
+        list.any(item.plugins, fn(plugin) {
+          case plugin {
+            extension.RequestContextPlugin(_, True) -> True
+            _ -> False
+          }
+        })
+      case required && !list.contains(active, item.name) {
+        True ->
+          Error("required request context " <> item.name <> " is unavailable")
+        False -> Ok(Nil)
+      }
+    }),
+  )
+  Ok(
+    list.flat_map(composition.extensions, fn(item) {
+      list.filter_map(item.plugins, fn(plugin) {
+        case plugin {
+          extension.RequestContextPlugin(callback, _) ->
+            Ok(#(item.name, callback))
+          _ -> Error(Nil)
+        }
+      })
+    }),
+  )
+}
+
+pub fn has_request_context(composition: Composition) -> Bool {
+  list.any(composition.requested, fn(item) {
+    list.any(item.plugins, fn(plugin) {
+      case plugin {
