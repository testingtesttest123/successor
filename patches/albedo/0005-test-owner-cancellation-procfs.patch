+    def test_repeated_cancellation_cannot_extend_cleanup(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            code = (
+                "import os,signal,time; from pathlib import Path; "
+                "signal.signal(signal.SIGTERM,signal.SIG_IGN); "
+                "signal.signal(signal.SIGINT,signal.SIG_IGN); "
+                f"Path({str(report)!r}).write_text(str(os.getpid())); time.sleep(30)"
+            )
+            process = subprocess.Popen([*OWNER, sys.executable, "-c", code])
+            try:
+                ready = time.monotonic() + 3
+                while not report.exists():
+                    self.assertLess(time.monotonic(), ready)
+                    time.sleep(0.01)
+                deadline = time.monotonic() + 3
+                signals = (signal.SIGTERM, signal.SIGINT)
+                sent = 0
+                while process.poll() is None and time.monotonic() < deadline:
+                    try:
+                        os.kill(process.pid, signals[sent % 2])
+                    except ProcessLookupError:
+                        break
+                    sent += 1
+                    time.sleep(0.1)
+                self.assertIsNotNone(
+                    process.poll(),
+                    "owner stayed alive beyond three seconds of repeated cancellation",
+                )
+                self.assertGreater(sent, 1)
+                self.assertEqual(process.wait(timeout=6), 137)
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(int(report.read_text()), 0)
+                with self.assertRaises(ChildProcessError):
+                    os.waitpid(process.pid, os.WNOHANG)
+            finally:
+                if process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=6)
+                self.reap_fixture(report)
+
+    def test_procfs_esrch_race_still_cleans_owned_descendants(self):
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / "pid"
+            observed = Path(folder) / "errno"
+            command = (
+                "import subprocess; from pathlib import Path; "
+                "child=subprocess.Popen(['sleep','30'],start_new_session=True,"
+                "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); "
+                f"Path({str(report)!r}).write_text(str(child.pid))"
+            )
+            # Open a real procfs file, then reap that process before read().
+            # This yields kernel ESRCH, without substituting a fake exception.
+            shim = textwrap.dedent(f"""
+                import errno, runpy, subprocess, sys
+                from pathlib import Path
+                owner = runpy.run_path({str(TEST / "process_owner.py")!r})
+                victim = subprocess.Popen(['sleep', '30'])
+                victim_stat = Path(f'/proc/{{victim.pid}}/stat')
+                original_open = Path.open
+                class DisappearingStat:
+                    def __init__(self, stream):
+                        self.stream = stream
+                    def __enter__(self):
+                        return self
+                    def __exit__(self, *args):
+                        self.stream.close()
+                    def read(self, *args):
+                        try:
+                            return self.stream.read(*args)
+                        except OSError as error:
+                            Path({str(observed)!r}).write_text(str(error.errno))
+                            raise
+                def open_then_disappear(path, *args, **kwargs):
+                    stream = original_open(path, *args, **kwargs)
+                    if path == victim_stat:
+                        victim.kill()
+                        victim.wait()
+                        return DisappearingStat(stream)
+                    return stream
+                Path.open = open_then_disappear
+                try:
+                    raise SystemExit(owner['run']([sys.executable, '-c', {command!r}]))
+                finally:
+                    Path.open = original_open
+                    if victim.poll() is None:
+                        victim.kill()
+                        victim.wait()
+            """)
+            try:
+                result = subprocess.run(
+                    [sys.executable, "-c", shim],
+                    capture_output=True,
+                    text=True,
+                    timeout=10,
+                )
+                self.assertEqual(int(observed.read_text()), errno.ESRCH)
+                self.assertEqual(result.returncode, 1, result.stderr)
+                with self.assertRaises(ProcessLookupError, msg=result.stderr):
+                    os.kill(int(report.read_text()), 0)
+                self.assertNotIn("Traceback", result.stderr)
+                self.assertIn("live descendants after command exit", result.stderr)
+            finally:
+                self.reap_fixture(report)
+
